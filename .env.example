# Frontend Environment Variables (.env.local)
# Safe for browser exposure if prefixed with NEXT_PUBLIC_

# -----------------------------------------------------------------------------
# Supabase Configuration (Public)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here

# -----------------------------------------------------------------------------
# Backend API URL (Production Vercel Domain or Localhost)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=https://your-backend.vercel.app

# -----------------------------------------------------------------------------
# Google Gemini API Key (Server-side Next.js route: /api/match)
# -----------------------------------------------------------------------------
# Used exclusively server-side in Next.js runtime (never exposed to browser)
GEMINI_API_KEY=your_gemini_api_key_here
